def check_triangle():
    print("--- Проверка типа треугольника ---")
    try:  

        a = int(input("Введите длину первой стороны: "))
        b = int(input("Введите длину второй стороны: "))
        c = int(input("Введите длину третьей стороны: "))
    except ValueError:
        print("Ошибка: нужно вводить только целые числа!")
        return
    if a <= 0 or b <= 0 or c <= 0:
        print("Ошибка: стороны треугольника должны быть больше нуля.")
    elif a + b <= c or a + c <= b or b + c <= a:
        print("Ошибка: треугольника с такими сторонами не существует.")
    elif a == b == c:
        print("Полученный треугольник: равносторонний")
    elif a == b or a == c or b == c:
        print("Полученный треугольник: равнобедренный")
    else:
        print("Полученный треугольник: разносторонний")
    print("----------------------------------\n")

while True:
    check_triangle()

    answer = input("Начать снова? (да/нет): ")

    if answer != 'да':
        print("Программа завершена.")
        break
